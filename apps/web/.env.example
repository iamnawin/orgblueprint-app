# Required for local dev, Next.js build, Prisma db push, auth, saved blueprints, and E2E tests.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Required for auth/session signing.
AUTH_SECRET="replace-with-a-long-random-string"
# Legacy alias still accepted by the app:
# NEXTAUTH_SECRET="replace-with-a-long-random-string"

ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
