{
  "name": "orgblueprint-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @orgblueprint/web",
    "build": "npm run build -w @orgblueprint/core && npm run build -w @orgblueprint/web",
    "db:push": "npm run db:push -w @orgblueprint/web",
    "lint": "npm run lint -w @orgblueprint/web",
    "typecheck": "npm run typecheck -w @orgblueprint/core && npm run typecheck -w @orgblueprint/web",
    "doctor": "node scripts/doctor.mjs",
    "test:core": "tsx packages/core/test/regression.test.ts",
    "test:web:v2-render": "npm run test:v2-render -w @orgblueprint/web",
    "test:e2e": "npm run test:e2e -w @orgblueprint/web",
    "test:e2e:db": "npm run test:e2e:db -w @orgblueprint/web"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
